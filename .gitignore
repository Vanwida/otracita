# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# OAuth credentials JSON descargados de SumUp / otros proveedores —
# contienen secrets. Mueve los datos a .env.local y borra el archivo.
otracita-web.json
*-credentials.json
*-oauth.json
sumup-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
