# -----------------------------------------------------------------------------
# Agendalo — environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.
# -----------------------------------------------------------------------------

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://agendalo.aistudios.pro

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-32-random-bytes-hex
BETTER_AUTH_URL=https://agendalo.aistudios.pro

# -----------------------------------------------------------------------------
# Stripe — subscriptions (platform) + Connect destination charges
#
# Configurar DOS webhooks en Stripe Dashboard:
#   1. Platform endpoint → /api/webhooks/stripe (mismo path)
#      Eventos: checkout.session.completed, checkout.session.expired,
#               charge.refunded, customer.subscription.created,
#               customer.subscription.updated, customer.subscription.deleted,
#               customer.subscription.trial_will_end
#      Secret → STRIPE_WEBHOOK_SECRET
#
#   2. Connect endpoint → /api/webhooks/stripe (mismo path; el handler
#      auto-detecta cuál firmó el payload).
#      Eventos: account.updated, charge.refunded
#      Secret → STRIPE_CONNECT_WEBHOOK_SECRET
#
# Application fees (Connect): porcentaje que cobra otracita sobre cada
# pago/propina. Defaults sensatos si no se setean.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
OTRACITA_APPLICATION_FEE_PERCENT=2.9
OTRACITA_TIP_FEE_PERCENT=0

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
#
# META_APP_SECRET is used to verify the HMAC-SHA256 signature of every webhook
# POST from Meta. Without it the webhook fails closed and rejects all incoming
# messages.
# Get it from: developers.facebook.com → your app → Settings → Basic → App Secret
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# OpenAI / xAI (Grok)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs (recepcionista IA — Estudio)
# Voz castellana nativa para los voice agents. Plan mínimo Starter ($6/mes,
# necesario para Conversational AI Agents). Genera la API key en:
#   https://elevenlabs.io/app/settings/api-keys
# El AGENT_ID lo creas dentro de tu workspace de ElevenLabs (Conversational
# AI > Agents > Create Agent) — uno por voz que ofreces (JeiJo, Dante, etc).
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_DEFAULT=
# Voz por defecto. La sobrescribimos en cada sesión via override del SDK
# para no depender de la voz que esté seteada en el Agent. Más adelante,
# el barbero podrá elegir su voz preferida desde el dashboard y se
# guardará en clients.voiceId (Phase 2).
ELEVENLABS_VOICE_ID_DEFAULT=
# Provider switch para hacer rollback rápido a Grok si ElevenLabs cae.
# Valores válidos: 'elevenlabs' | 'grok'. Default: 'elevenlabs' tras
# migración Q1 (era 'grok' antes).
VOICE_PROVIDER=elevenlabs

# -----------------------------------------------------------------------------
# Postmark inbound (Booksy email sync)
# -----------------------------------------------------------------------------
POSTMARK_INBOUND_SECRET=

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Google (SSO + service account for Booksy sync)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# SumUp Tap to Pay (Pro tier)
#
# Configurar la app en https://developer.sumup.com → OAuth credentials.
# El AFFILIATE_KEY se requiere para el SDK móvil.
# -----------------------------------------------------------------------------
SUMUP_OAUTH_CLIENT_ID=
SUMUP_OAUTH_CLIENT_SECRET=
SUMUP_OAUTH_REDIRECT_URI=https://otracita.es/api/sumup/oauth/callback
SUMUP_AFFILIATE_KEY=

# -----------------------------------------------------------------------------
# Push notifications (VAPID — Web Push)
# Generar par de claves con: npx web-push generate-vapid-keys
# La PUBLIC se expone al cliente con NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# El CONTACT es un mailto: o https:// según el spec.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:soporte@otracita.es
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# VeriFactu (AEAT) — meta del SIF (Sistema Informático de Facturación)
#
# Se inyecta en el XML enviado a AEAT. El NIF aquí es el del FABRICANTE del
# software (Vanwida), NO el del barbero (el del barbero se lee de la row
# clients.fiscalNif). Mientras no haya conexión real con AEAT, valen los
# defaults; cuando se firme el contrato con AEAT, poner valores reales.
# -----------------------------------------------------------------------------
VERIFACTU_ENV=pruebas
VERIFACTU_SIF_NIF=
VERIFACTU_SIF_NAME=Vanwida
VERIFACTU_SIF_ID=
VERIFACTU_SIF_INSTALL=
VERIFACTU_SIF_VERSION=1.0

# -----------------------------------------------------------------------------
# Operativa / ops
# -----------------------------------------------------------------------------
# Número de WhatsApp donde se envían las notifs internas (nuevos signups,
# pagos, etc). Formato E.164 sin '+'.
ALEX_WHATSAPP_NUMBER=
# Si en algún momento queremos parar los awards de fidelidad sin tocar
# código, set este a "true". Default OFF (en producción se otorgan).
LOYALTY_AWARD_DRY_RUN=false
