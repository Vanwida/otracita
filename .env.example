# -----------------------------------------------------------------------------
# Agendalo — environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.
# -----------------------------------------------------------------------------

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://agendalo.aistudios.pro

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-32-random-bytes-hex
BETTER_AUTH_URL=https://agendalo.aistudios.pro

# -----------------------------------------------------------------------------
# Stripe (subscriptions + webhook)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
#
# META_APP_SECRET is used to verify the HMAC-SHA256 signature of every webhook
# POST from Meta. Without it the webhook fails closed and rejects all incoming
# messages.
# Get it from: developers.facebook.com → your app → Settings → Basic → App Secret
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# OpenAI / xAI (Grok)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs (recepcionista IA — Estudio)
# Voz castellana nativa para los voice agents. Plan mínimo Starter ($6/mes,
# necesario para Conversational AI Agents). Genera la API key en:
#   https://elevenlabs.io/app/settings/api-keys
# El AGENT_ID lo creas dentro de tu workspace de ElevenLabs (Conversational
# AI > Agents > Create Agent) — uno por voz que ofreces (JeiJo, Dante, etc).
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_DEFAULT=
# Voz por defecto. La sobrescribimos en cada sesión via override del SDK
# para no depender de la voz que esté seteada en el Agent. Más adelante,
# el barbero podrá elegir su voz preferida desde el dashboard y se
# guardará en clients.voiceId (Phase 2).
ELEVENLABS_VOICE_ID_DEFAULT=
# Provider switch para hacer rollback rápido a Grok si ElevenLabs cae.
# Valores válidos: 'elevenlabs' | 'grok'. Default: 'elevenlabs' tras
# migración Q1 (era 'grok' antes).
VOICE_PROVIDER=elevenlabs

# -----------------------------------------------------------------------------
# Postmark inbound (Booksy email sync)
# -----------------------------------------------------------------------------
POSTMARK_INBOUND_SECRET=

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Google (calendar + service account for Booksy sync)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY=
