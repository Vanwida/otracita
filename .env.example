# -----------------------------------------------------------------------------
# otracita — environment variables
#
# Copia a .env.local y rellena los valores reales ahí. Este fichero lista
# NOMBRES de variables, nunca valores secretos: los que llevan valor aquí son
# defaults públicos (dominios, porcentajes, flags), no credenciales.
# -----------------------------------------------------------------------------

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public site URL (opcional — sólo se usa para preview/staging donde la URL
# difiere de producción). En dev y prod se cae al default de src/lib/site.ts
# (`https://otracita.es`).
# NEXT_PUBLIC_SITE_URL=https://tu-dominio-de-staging.com

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
# Genera el secret con: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://otracita.es

# Allow-list EXACTA de emails con rol admin de plataforma (separados por comas).
# Match exacto, nunca por subcadena. El email del owner se incluye SIEMPRE en
# código como red de seguridad; aquí van los adicionales (p.ej. co-fundador).
# El dominio @aistudios.pro también es admin por defecto (ver src/lib/auth/admin.ts).
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Stripe — subscriptions (platform) + Connect destination charges
#
# Configurar DOS webhooks en Stripe Dashboard:
#   1. Platform endpoint → /api/webhooks/stripe (mismo path)
#      Eventos: checkout.session.completed, checkout.session.expired,
#               charge.refunded, customer.subscription.created,
#               customer.subscription.updated, customer.subscription.deleted,
#               customer.subscription.trial_will_end
#      Secret → STRIPE_WEBHOOK_SECRET
#
#   2. Connect endpoint → /api/webhooks/stripe (mismo path; el handler
#      auto-detecta cuál firmó el payload).
#      Eventos: account.updated, charge.refunded
#      Secret → STRIPE_CONNECT_WEBHOOK_SECRET
#
# Application fees (Connect): porcentaje que cobra otracita sobre cada
# pago/propina. Defaults sensatos si no se setean.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Publishable key — la usa el Payment Element del form de reserva /b/[slug]
# para guardar la tarjeta del cliente (tarifa no-show). Pública por diseño.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
OTRACITA_APPLICATION_FEE_PERCENT=2.9
OTRACITA_TIP_FEE_PERCENT=0

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
#
# META_APP_SECRET is used to verify the HMAC-SHA256 signature of every webhook
# POST from Meta. Without it the webhook fails closed and rejects all incoming
# messages.
# Get it from: developers.facebook.com → your app → Settings → Basic → App Secret
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# OpenAI / xAI (Grok)
#
# XAI_API_KEY alimenta dos cosas: el parser LLM de los emails de Booksy y la
# recepcionista de voz (client secrets efímeros de xAI Realtime).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# Recepcionista IA — voz (tier Estudio)
#
# Provider por defecto: 'grok'. El default vive en el CÓDIGO
# (src/app/api/voice/token/route.ts), así que sin esta variable el endpoint
# ya habla Grok y sólo necesita XAI_API_KEY (arriba). Déjala vacía salvo que
# quieras forzar el plan B.
#
# Valores válidos: 'grok' | 'elevenlabs'.
VOICE_PROVIDER=

# Plan B — ElevenLabs Conversational AI. Se descartó por coste en ago-2026,
# pero el camino sigue entero: poniendo VOICE_PROVIDER=elevenlabs y estas tres
# variables se vuelve atrás sin desplegar código.
#   API key:  https://elevenlabs.io/app/settings/api-keys (plan Starter mínimo)
#   AGENT_ID: workspace ElevenLabs → Conversational AI > Agents > Create Agent
#   VOICE_ID: voz por defecto; en Phase 2 la sobrescribirá clients.voiceId
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_DEFAULT=
ELEVENLABS_VOICE_ID_DEFAULT=

# -----------------------------------------------------------------------------
# Resend (outbound transactional email)
#
# Genera la key en https://resend.com/api-keys. Dominio `otracita.es` ya
# verificado (DKIM + SPF + DMARC). Sender hardcoded en
# src/lib/email/notify.ts → `otracita <hola@otracita.es>` (alias real en
# Google Workspace que forwarda a Alex). Si la key no está seteada, los
# envíos se saltan silenciosamente (log + skipped:true) y los callers
# operativos caen a WhatsApp via notifyAlex.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Postmark inbound (Booksy email sync)
#
# SOLO inbound — Postmark sigue siendo el receptor de los emails de Booksy
# que parseamos en /api/email/inbound. El outbound se migró a Resend.
# -----------------------------------------------------------------------------
POSTMARK_INBOUND_SECRET=

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Google (SSO + service account for Booksy sync)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# SumUp Tap to Pay (Pro tier)
#
# Configurar la app en https://developer.sumup.com → OAuth credentials.
# El AFFILIATE_KEY se requiere para el SDK móvil.
# -----------------------------------------------------------------------------
SUMUP_OAUTH_CLIENT_ID=
SUMUP_OAUTH_CLIENT_SECRET=
SUMUP_OAUTH_REDIRECT_URI=https://otracita.es/api/sumup/oauth/callback
SUMUP_AFFILIATE_KEY=

# -----------------------------------------------------------------------------
# Push notifications (VAPID — Web Push)
# Generar par de claves con: npx web-push generate-vapid-keys
# La PUBLIC se expone al cliente con NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# El CONTACT es un mailto: o https:// según el spec.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:soporte@otracita.es
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# VeriFactu (AEAT) — meta del SIF (Sistema Informático de Facturación)
#
# Se inyecta en el XML enviado a AEAT. El NIF aquí es el del FABRICANTE del
# software (Vanwida), NO el del barbero (el del barbero se lee de la row
# clients.fiscalNif). Mientras no haya conexión real con AEAT, valen los
# defaults; cuando se firme el contrato con AEAT, poner valores reales.
# -----------------------------------------------------------------------------
VERIFACTU_ENV=pruebas
VERIFACTU_SIF_NIF=
VERIFACTU_SIF_NAME=Vanwida
VERIFACTU_SIF_ID=
VERIFACTU_SIF_INSTALL=
VERIFACTU_SIF_VERSION=1.0

# -----------------------------------------------------------------------------
# Operativa / ops
# -----------------------------------------------------------------------------
# Número de WhatsApp donde se envían las notifs internas (nuevos signups,
# pagos, etc). Formato E.164 sin '+'.
ALEX_WHATSAPP_NUMBER=
# Si en algún momento queremos parar los awards de fidelidad sin tocar
# código, set este a "true". Default OFF (en producción se otorgan).
LOYALTY_AWARD_DRY_RUN=false
